# Copy this file to .env and fill values
RAILRADAR_API_KEY=
FLASK_SECRET_KEY=
LIVE_TRACKING_ONLY=1
LIVE_SNAPSHOT_POLL_SECONDS=60
LIVE_UPDATE_INTERVAL_SECONDS=15
RAILRADAR_BASE_URL=https://railradar.in
LIVE_SNAPSHOT_ENDPOINT=/app/v1/live-map

# Optional: Residential proxy to bypass cloud IP blocks (e.g. DataImpulse)
# Format: http://login:password@host:port
PROXY_URL=
